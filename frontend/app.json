{
  "expo": {
    "name": "אילתוש",
    "slug": "eilatush",
    "owner": "levkazaryan",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eilatush",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "primaryColor": "#14B8B3",
    "description": "אילתוש — האפליקציה המקומית של אילת. אירועים, עסקים, עבודות, חדשות, ועוזרת AI חכמה בלחיצת כפתור.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.eilatush",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": [
          "he",
          "en"
        ],
        "CFBundleDevelopmentRegion": "he",
        "NSLocationWhenInUseUsageDescription": "Show weather and events near you in Eilat"
      }
    },
    "android": {
      "package": "app.eilatush",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0172E5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0172E5"
        }
      ],
      "./plugins/withDisableAndroidLintChecks",
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cc2c7397-13c0-499f-aab2-a41c2bc214d6"
      }
    }
  }
}
